{
  "name": "@minevibe/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "MineVibe mod <-> Node bridge protocol: zod schemas, MVF1 frame codec and JSON fixtures.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "protocol.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
