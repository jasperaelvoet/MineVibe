{
	"schemaVersion": 1,
	"id": "minevibe-gametest",
	"version": "${version}",
	"name": "MineVibe GameTests",
	"description": "Server and client GameTests for MineVibe. Development only, never shipped.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.minevibe.gametest.GameTestWorldSetup"
		],
		"fabric-gametest": [
			"dev.minevibe.gametest.MineVibeServerGameTests",
			"dev.minevibe.gametest.agent.AgentGameTests",
			"dev.minevibe.gametest.agent.AgentLifecycleGameTests",
			"dev.minevibe.gametest.org.OrgGameTests",
			"dev.minevibe.gametest.agent.SkillGameTests",
			"dev.minevibe.gametest.agent.SkillMoreGameTests",
			"dev.minevibe.gametest.pc.PcGameTests",
			"dev.minevibe.gametest.agent.SeatWiringGameTests",
			"dev.minevibe.gametest.agent.ProtectionGameTests"
		],
		"fabric-client-gametest": [
			"dev.minevibe.gametest.client.MineVibeClientGameTests",
			"dev.minevibe.gametest.agent.AgentClientGameTests",
			"dev.minevibe.gametest.ui.UiClientGameTests",
			"dev.minevibe.gametest.org.OrgClientGameTests",
			"dev.minevibe.gametest.client.IntegrationClientGameTests"
		]
	},
	"depends": {
		"minevibe": "*",
		"fabric-api": "*"
	}
}
